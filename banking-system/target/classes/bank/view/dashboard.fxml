<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="bank.view.DashboardView">
    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="welcomeLabel" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#onLogout"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="12"/>
            </padding>
            <Label text="My accounts (select one to deposit, withdraw or see its history)" styleClass="section"/>
            <TableView fx:id="accountsTable" prefHeight="190" VBox.vgrow="SOMETIMES">
                <columns>
                    <TableColumn fx:id="typeColumn" text="Type"/>
                    <TableColumn fx:id="numberColumn" text="Account number"/>
                    <TableColumn fx:id="branchColumn" text="Branch"/>
                    <TableColumn fx:id="balanceColumn" text="Balance"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Amount (BWP):"/>
                <TextField fx:id="amountField" promptText="e.g. 250.00" prefWidth="140"/>
                <Button text="Deposit" onAction="#onDeposit" styleClass="primary-button"/>
                <Button text="Withdraw" onAction="#onWithdraw"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Open account..." onAction="#onOpenAccount"/>
                <Button text="Run monthly interest (staff)" onAction="#onPayInterest"/>
            </HBox>
            <Label fx:id="messageLabel" wrapText="true"/>
            <Label text="Transaction history" styleClass="section"/>
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Date"/>
                    <TableColumn fx:id="txTypeColumn" text="Type"/>
                    <TableColumn fx:id="txAmountColumn" text="Amount"/>
                    <TableColumn fx:id="balanceAfterColumn" text="Balance after"/>
                    <TableColumn fx:id="descriptionColumn" text="Description"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
