<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="bank.view.RegisterView">
    <VBox spacing="12" maxWidth="460" maxHeight="-Infinity">
        <padding>
            <Insets top="24" right="24" bottom="24" left="24"/>
        </padding>
        <Label text="Register a new customer" styleClass="title"/>
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <Label text="Customer ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="customerIdField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label text="First name" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="firstNameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label text="Surname" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="surnameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label text="Address" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="addressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Phone number" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" promptText="digits only" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label text="Password" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <PasswordField fx:id="passwordField" promptText="at least 4 characters"
                           GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label text="Confirm password" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <PasswordField fx:id="confirmField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            <CheckBox fx:id="employedCheck" text="I am currently employed (needed for a Cheque account)"
                      GridPane.rowIndex="7" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        </GridPane>
        <HBox spacing="10">
            <Button text="Register" onAction="#onRegister" defaultButton="true" styleClass="primary-button"/>
            <Button text="Back to login" onAction="#onBack" cancelButton="true"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
    </VBox>
</StackPane>
