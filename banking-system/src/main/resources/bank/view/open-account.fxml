<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="bank.view.OpenAccountView" spacing="12" prefWidth="440">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Open a new account" styleClass="title"/>
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="130" prefWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Account type" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="typeBox" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Opening deposit (BWP)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="depositField" promptText="e.g. 500.00" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Employer name" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="companyNameField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Employer address" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="companyAddressField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="hintLabel" styleClass="hint-label" wrapText="true"/>
    <HBox spacing="10">
        <Button text="Open account" onAction="#onOpen" defaultButton="true" styleClass="primary-button"/>
        <Button text="Cancel" onAction="#onCancel" cancelButton="true"/>
    </HBox>
    <Label fx:id="messageLabel" styleClass="error-label" wrapText="true"/>
</VBox>
